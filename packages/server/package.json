{
  "name": "@azuron/server",
  "version": "0.1.0",
  "description": "AZURON local loopback Hono daemon, SQLite WAL engine, provider adapters, and AI terminal",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node --max-old-space-size=256 dist/index.js",
    "test": "node --test --experimental-strip-types test/azuron-core.test.ts",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@azuron/contract": "*",
    "@hono/node-server": "^1.13.7",
    "chalk": "^5.3.0",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
